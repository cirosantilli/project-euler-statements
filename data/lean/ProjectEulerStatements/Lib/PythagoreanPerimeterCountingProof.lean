import ProjectEulerStatements.Lib.PythagoreanPerimeterTable
import ProjectEulerStatements.Lib.PythagoreanPerimeters

/-! Every table increment corresponds to exactly one unordered right triangle. -/
namespace ProjectEulerStatements.PythagoreanPerimeterCounting
open ProjectEulerStatements.PythagoreanPerimeters

set_option Elab.async false

private theorem mem_range (first count value : Nat) :
    value ∈ List.range' first count ↔ first ≤ value ∧ value < first + count := by
  simp only [List.mem_range', Nat.one_mul]
  constructor
  · rintro ⟨index, less, rfl⟩
    omega
  · rintro ⟨lower, upper⟩
    exact ⟨value - first, by omega, by omega⟩

private theorem multiple_mem (m n first count : Nat) (t : Nat × Nat × Nat) :
    t ∈ multipleParameters m n first count ↔
      t.1 = m ∧ t.2.1 = n ∧ first ≤ t.2.2 ∧ t.2.2 < first + count := by
  rcases t with ⟨a, b, k⟩
  simp only [multipleParameters, List.mem_map]
  constructor
  · rintro ⟨value, member, equal⟩
    obtain ⟨rfl, rest⟩ := Prod.mk.inj equal
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj rest
    exact ⟨rfl, rfl, (mem_range first count value).mp member⟩
  · rintro ⟨rfl, rfl, lower, upper⟩
    exact ⟨k, (mem_range first count k).mpr ⟨lower, upper⟩, rfl⟩

private theorem row_mem (limit m first count : Nat) (t : Nat × Nat × Nat) :
    t ∈ rowParameters limit m first count ↔ t.1 = m ∧
      first ≤ t.2.1 ∧ t.2.1 < first + count ∧ permitted limit m t.2.1 = true ∧
      1 ≤ t.2.2 ∧ t.2.2 ≤ limit / perimeter m t.2.1 := by
  simp only [rowParameters, List.mem_flatMap]
  constructor
  · rintro ⟨n, member, selected⟩
    split at selected
    next allowed =>
      obtain ⟨sameM, sameN, lower, upper⟩ := (multiple_mem m n 1 _ t).mp selected
      have bounds := (mem_range first count n).mp member
      subst n
      exact ⟨sameM, bounds.1, bounds.2, allowed, lower, by omega⟩
    next rejected => simp at selected
  · rintro ⟨sameM, lower, upper, allowed, positive, bounded⟩
    refine ⟨t.2.1, (mem_range first count _).mpr ⟨lower, upper⟩, ?_⟩
    rw [if_pos allowed]
    exact (multiple_mem m t.2.1 1 _ t).mpr ⟨sameM, rfl, positive, by omega⟩

private theorem outer_mem (limit first count : Nat) (t : Nat × Nat × Nat) :
    t ∈ outerParameters limit first count ↔ first ≤ t.1 ∧ t.1 < first + count ∧
      2 * t.1 * (t.1 + 1) ≤ limit ∧ 1 ≤ t.2.1 ∧ t.2.1 < t.1 ∧
      permitted limit t.1 t.2.1 = true ∧ 1 ≤ t.2.2 ∧ t.2.2 ≤ limit / perimeter t.1 t.2.1 := by
  simp only [outerParameters, List.mem_flatMap]
  constructor
  · rintro ⟨m, member, selected⟩
    split at selected
    next active =>
      obtain ⟨same, lower, upper, allowed, positive, bounded⟩ := (row_mem limit m 1 _ t).mp selected
      have bounds := (mem_range first count m).mp member
      have mPositive : 0 < m := by omega
      subst m
      exact ⟨bounds.1, bounds.2, active, lower, by omega, allowed, positive, bounded⟩
    next stopped => simp at selected
  · rintro ⟨lower, upper, active, nPositive, ordered, allowed, kPositive, bounded⟩
    refine ⟨t.1, (mem_range first count _).mpr ⟨lower, upper⟩, ?_⟩
    rw [if_pos active]
    exact (row_mem limit t.1 1 _ t).mpr ⟨rfl, nPositive, by omega, allowed, kPositive, bounded⟩

private theorem perimeter_positive {m n k : Nat} (parameters : Parameters m n k) :
    0 < perimeter m n := by
  unfold perimeter
  exact Nat.mul_pos
    (Nat.mul_pos (by decide) (by have := parameters.2.1; have := parameters.1; omega))
    (by have := parameters.1; omega)

private theorem parameter_bounds {limit m n k : Nat} (parameters : Parameters m n k)
    (bounded : k * perimeter m n ≤ limit) :
    2 ≤ m ∧ m ≤ limit ∧ 2 * m * (m + 1) ≤ limit ∧ perimeter m n ≤ limit := by
  obtain ⟨nPositive, ordered, kPositive, _, _⟩ := parameters
  have primitiveLe : perimeter m n ≤ k * perimeter m n := Nat.le_mul_of_pos_left _ kPositive
  have sumLe : m + n ≤ perimeter m n := Nat.le_mul_of_pos_left _ (by omega : 0 < 2 * m)
  have minimumLe : 2 * m * (m + 1) ≤ perimeter m n :=
    Nat.mul_le_mul_left (2 * m) (by omega)
  omega

/-- The finite list generated by the actual loops contains every admissible
parameter triple whose perimeter is below the supplied limit. -/
theorem parameters_mem (limit : Nat) (t : Nat × Nat × Nat) :
    t ∈ outerParameters limit 2 (limit - 1) ↔
      Parameters t.1 t.2.1 t.2.2 ∧ t.2.2 * perimeter t.1 t.2.1 ≤ limit := by
  rw [outer_mem]
  constructor
  · rintro ⟨_, _, _, nPositive, ordered, allowed, kPositive, bounded⟩
    have accepted : (t.1 - t.2.1) % 2 = 1 ∧ Nat.Coprime t.1 t.2.1 ∧ perimeter t.1 t.2.1 ≤ limit :=
      of_decide_eq_true allowed
    have parameters : Parameters t.1 t.2.1 t.2.2 :=
      ⟨nPositive, ordered, kPositive, accepted.2.1, accepted.1⟩
    exact ⟨parameters, (Nat.le_div_iff_mul_le (perimeter_positive parameters)).mp bounded⟩
  · rintro ⟨parameters, bounded⟩
    have bounds := parameter_bounds parameters bounded
    refine ⟨bounds.1, by omega, bounds.2.2.1, parameters.1, parameters.2.1, ?_,
      parameters.2.2.1, (Nat.le_div_iff_mul_le (perimeter_positive parameters)).mpr bounded⟩
    exact decide_eq_true ⟨parameters.2.2.2.2, parameters.2.2.2.1, bounds.2.2.2⟩

private theorem tagged_nodup {α β : Type*} (items : List α) (family : α → List β) (tag : β → α)
    (distinct : items.Nodup) (families : ∀ item ∈ items, (family item).Nodup)
    (marked : ∀ item value, value ∈ family item → tag value = item) :
    (items.flatMap family).Nodup := by
  apply List.nodup_flatMap.mpr
  refine ⟨families, distinct.imp ?_⟩
  intro left right different value first second
  exact different ((marked left value first).symm.trans (marked right value second))

private theorem multiple_nodup (m n first count : Nat) :
    (multipleParameters m n first count).Nodup := by
  apply (List.nodup_range' (s := first) (n := count)).map
  intro left right same
  exact congrArg (fun t : Nat × Nat × Nat => t.2.2) same

private theorem row_nodup (limit m first count : Nat) :
    (rowParameters limit m first count).Nodup := by
  apply tagged_nodup _ _ (fun t : Nat × Nat × Nat => t.2.1) List.nodup_range'
  · intro n _
    split
    · exact multiple_nodup m n 1 _
    · exact List.nodup_nil
  · intro n value member
    split at member
    next allowed => exact ((multiple_mem m n 1 _ value).mp member).2.1
    next rejected => simp at member

theorem parameters_nodup (limit first count : Nat) :
    (outerParameters limit first count).Nodup := by
  apply tagged_nodup _ _ (fun t : Nat × Nat × Nat => t.1) List.nodup_range'
  · intro m _
    split
    · exact row_nodup limit m 1 _
    · exact List.nodup_nil
  · intro m value member
    split at member
    next active => exact ((row_mem limit m 1 _ value).mp member).1
    next stopped => simp at member


/- Append within PythagoreanPerimeterCounting after parameter list proofs. -/
private def selectedParameters (limit p : Nat) : List ParameterTuple :=
  (outerParameters limit 2 (limit - 1)).filter
    (fun t => decide (p = t.2.2 * perimeter t.1 t.2.1))

private theorem selected_mem (limit p : Nat) (bounded : p ≤ limit) (t : ParameterTuple) :
    t ∈ selectedParameters limit p ↔
      Parameters t.1 t.2.1 t.2.2 ∧ t.2.2 * perimeter t.1 t.2.1 = p := by
  simp only [selectedParameters, List.mem_filter, parameters_mem, decide_eq_true_eq]
  constructor
  · rintro ⟨⟨parameters, _⟩, equal⟩
    exact ⟨parameters, equal.symm⟩
  · rintro ⟨parameters, equal⟩
    exact ⟨⟨parameters, by omega⟩, equal.symm⟩

private abbrev pairOf (t : ParameterTuple) : Nat × Nat :=
  ((sides t.1 t.2.1 t.2.2).1, (sides t.1 t.2.1 t.2.2).2.1)

private theorem perimeter_sum (t : ParameterTuple)
    (parameters : Parameters t.1 t.2.1 t.2.2) :
    (sides t.1 t.2.1 t.2.2).1 + (sides t.1 t.2.1 t.2.2).2.1 +
      (sides t.1 t.2.1 t.2.2).2.2 = t.2.2 * perimeter t.1 t.2.1 := by
  rw [sides_perimeter _ _ _ parameters]
  simp only [perimeter]
  ring

private theorem triangle_positive (p a b : Nat) (accepted : triangle p a b) :
    Canonical a b (p - a - b) := by
  rcases accepted with ⟨ordered, below, square⟩
  refine ⟨?_, ordered, below, square⟩
  by_contra notPositive
  have zero : a = 0 := by omega
  subst a
  nlinarith

private theorem triangle_perimeter (p a b : Nat) (accepted : triangle p a b) :
    a + b + (p - a - b) = p := by
  have below := accepted.2.1
  omega

private theorem image_member (limit p : Nat) (bounded : p ≤ limit) (t : ParameterTuple)
    (member : t ∈ selectedParameters limit p) : pairOf t ∈ solutionPairs p := by
  obtain ⟨parameters, equal⟩ := (selected_mem limit p bounded t).mp member
  have canonical := sides_canonical _ _ _ parameters
  have sum := (perimeter_sum t parameters).trans equal
  have third : p - (pairOf t).1 - (pairOf t).2 = (sides t.1 t.2.1 t.2.2).2.2 := by
    dsimp only [pairOf] at *
    omega
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_product.mpr ⟨Finset.mem_range.mpr (by dsimp only [pairOf]; omega),
    Finset.mem_range.mpr (by dsimp only [pairOf]; omega)⟩, ?_⟩
  change triangle p (sides t.1 t.2.1 t.2.2).1 (sides t.1 t.2.1 t.2.2).2.1
  unfold triangle
  rw [third]
  exact ⟨canonical.2.1, canonical.2.2.1, canonical.2.2.2⟩

private theorem pair_injective (limit p : Nat) (bounded : p ≤ limit)
    (left right : ParameterTuple) (leftMember : left ∈ selectedParameters limit p)
    (rightMember : right ∈ selectedParameters limit p) (same : pairOf left = pairOf right) :
    left = right := by
  obtain ⟨leftParameters, leftPerimeter⟩ := (selected_mem limit p bounded left).mp leftMember
  obtain ⟨rightParameters, rightPerimeter⟩ := (selected_mem limit p bounded right).mp rightMember
  have leftSum := (perimeter_sum left leftParameters).trans leftPerimeter
  have rightSum := (perimeter_sum right rightParameters).trans rightPerimeter
  have first := congrArg Prod.fst same
  have second := congrArg Prod.snd same
  dsimp only [pairOf] at first second
  have third : (sides left.1 left.2.1 left.2.2).2.2 =
      (sides right.1 right.2.1 right.2.2).2.2 := by
    omega
  have sidesEqual : sides left.1 left.2.1 left.2.2 = sides right.1 right.2.1 right.2.2 := by
    apply Prod.ext first
    exact Prod.ext second third
  obtain ⟨chosen, _, unique⟩ := canonical_unique
    (sides left.1 left.2.1 left.2.2).1 (sides left.1 left.2.1 left.2.2).2.1
    (sides left.1 left.2.1 left.2.2).2.2 (sides_canonical _ _ _ leftParameters)
  exact (unique left ⟨leftParameters, rfl⟩).trans
    (unique right ⟨rightParameters, sidesEqual.symm⟩).symm

private theorem image_pairs (limit p : Nat) (bounded : p ≤ limit) :
    ((selectedParameters limit p).toFinset.image pairOf) = solutionPairs p := by
  ext pair
  constructor
  · intro member
    obtain ⟨t, selected, rfl⟩ := Finset.mem_image.mp member
    exact image_member limit p bounded t (List.mem_toFinset.mp selected)
  · intro member
    obtain ⟨_, accepted⟩ := Finset.mem_filter.mp member
    obtain ⟨t, parameters, generated⟩ := (canonical_unique pair.1 pair.2 (p - pair.1 - pair.2)
      (triangle_positive p pair.1 pair.2 accepted)).exists
    have total := perimeter_sum t parameters
    rw [generated] at total
    have perimeter : t.2.2 * perimeter t.1 t.2.1 = p :=
      total.symm.trans (triangle_perimeter p pair.1 pair.2 accepted)
    apply Finset.mem_image.mpr
    refine ⟨t, List.mem_toFinset.mpr
      ((selected_mem limit p bounded t).mpr ⟨parameters, perimeter⟩), ?_⟩
    simp only [pairOf, generated]

/-- Exact Euclid multiplicity, with no finite bound specialization. -/
theorem table_correct (limit p : Nat) (bounded : p ≤ limit) :
    table limit p = P39.countSolutions p := by
  rw [table_count, countSolutions_card]
  have distinct : (selectedParameters limit p).Nodup :=
    (parameters_nodup limit 2 (limit - 1)).filter _
  have injective : Set.InjOn pairOf (selectedParameters limit p).toFinset := by
    intro left leftMember right rightMember same
    exact pair_injective limit p bounded left right
      (List.mem_toFinset.mp leftMember) (List.mem_toFinset.mp rightMember) same
  calc
    matching p (outerParameters limit 2 (limit - 1)) = (selectedParameters limit p).length := rfl
    _ = (selectedParameters limit p).toFinset.card := (List.toFinset_card_of_nodup distinct).symm
    _ = ((selectedParameters limit p).toFinset.image pairOf).card :=
      (Finset.card_image_iff.mpr injective).symm
    _ = (solutionPairs p).card := congrArg Finset.card (image_pairs limit p bounded)

theorem table_zero (limit : Nat) : table limit 0 = 0 :=
  (table_correct limit 0 (Nat.zero_le limit)).trans countSolutions_zero

private theorem fold_table_score (limit : Nat) (items : List Nat)
    (bounded : ∀ p ∈ items, p ≤ limit) (best : Nat) (bestBounded : best ≤ limit) :
    items.foldl (ArgMaximum.select (table limit)) best =
      items.foldl (ArgMaximum.select P39.countSolutions) best := by
  induction items generalizing best with
  | nil => rfl
  | cons head tail ih =>
      have headBounded := bounded head (by simp)
      have tailBounded : ∀ p ∈ tail, p ≤ limit := by
        intro p member
        exact bounded p (by simp [member])
      simp only [List.foldl_cons, ArgMaximum.select, table_correct limit best bestBounded,
        table_correct limit head headBounded]
      split
      · exact ih tailBounded head headBounded
      · exact ih tailBounded best bestBounded

/-- Strict improvement retains the first perimeter, including zero when every
count is zero; this is the reference's leftmost argmax convention. -/
theorem table_scan (limit : Nat) :
    (List.range' 1 limit).foldl (ArgMaximum.select (table limit)) 0 = P39.naive limit := by
  rw [naive_scan]
  apply fold_table_score limit _ _ 0 (by omega)
  intro p member
  have bounds := (mem_range 1 limit p).mp member
  omega

end ProjectEulerStatements.PythagoreanPerimeterCounting
